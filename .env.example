APP_NAME="ASNet WiFi Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
ASNET_PUBLIC_REGISTRATION=false
QRIS_ENABLED=false
QRIS_STATIC_IMAGE_PATH=images/qris/asnet-qris.png
QRIS_MERCHANT_NAME="ASNet"
QRIS_EXPIRATION_HOURS=24

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asnet_billing_pro
DB_USERNAME=asnet_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true pada deployment produksi HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backup lokal + salinan di luar server (S3/MinIO/R2 atau mount NAS).
MYSQLDUMP_BINARY=mysqldump
MYSQL_BINARY=mysql
BACKUP_TIMEOUT_SECONDS=600
BACKUP_MINIMUM_BYTES=1024
BACKUP_LOCAL_DISK=private
BACKUP_LOCAL_PATH=backups
BACKUP_LOCAL_RETENTION_DAYS=14
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_DISK=offsite
BACKUP_OFFSITE_PATH=asnet-backups
BACKUP_OFFSITE_RETENTION_DAYS=30

# Enkripsi arsip backup (sodium secretstream). Buat kunci dengan:
# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
BACKUP_ENCRYPTION_ENABLED=false
BACKUP_ENCRYPTION_KEY=

# Gunakan "s3" untuk S3/MinIO/R2, atau "local" untuk folder NAS yang ter-mount.
OFFSITE_DRIVER=local
OFFSITE_LOCAL_ROOT=/mnt/asnet-backup
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_DEFAULT_REGION=auto
OFFSITE_BUCKET=
OFFSITE_URL=
OFFSITE_ENDPOINT=
OFFSITE_USE_PATH_STYLE_ENDPOINT=false

# Monitoring dan alerting. Endpoint publik: GET /health
OPERATIONS_HEALTH_TOKEN=
OPERATIONS_SCHEDULER_MAX_AGE_MINUTES=10
OPERATIONS_BACKUP_MAX_AGE_HOURS=26
OPERATIONS_MIKROTIK_SYNC_MAX_AGE_MINUTES=15
OPERATIONS_QUEUE_BACKLOG_WARNING=100
OPERATIONS_DISK_FREE_WARNING_PERCENT=15
OPERATIONS_PROCESSING_TIMEOUT_MINUTES=10
OPERATIONS_ALERT_EMAILS=
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_TOKEN=
OPERATIONS_ALERT_COOLDOWN_MINUTES=30

# GenieACS NBI harus hanya dapat diakses melalui jaringan internal.
GENIEACS_CONNECT_TIMEOUT_SECONDS=3
GENIEACS_REQUEST_TIMEOUT_SECONDS=15
GENIEACS_SYNC_CHUNK_SIZE=100
GENIEACS_MISSING_AFTER_MINUTES=30
GENIEACS_SYNC_MAX_AGE_MINUTES=10
GENIEACS_FALLBACK_INFORM_INTERVAL_SECONDS=300
GENIEACS_HISTORY_RETENTION_DAYS=60
GENIEACS_ALERTS_ENABLED=true
GENIEACS_TASKS_ENABLED=true
GENIEACS_TASK_MAX_ATTEMPTS=3
GENIEACS_TASK_VERIFY_ATTEMPTS=5
GENIEACS_TASK_EXPIRY_MINUTES=30

VITE_APP_NAME="${APP_NAME}"

MIKROTIK_ALLOW_REAL_ACTIONS=false
MIKROTIK_AUTO_ISOLATION_ENABLED=false
MIKROTIK_GRACE_PERIOD_DAYS=7
MIKROTIK_ISOLATION_BATCH_SIZE=25
MIKROTIK_ISOLATION_MAX_ATTEMPTS=5
MIKROTIK_ISOLATION_RETRY_BASE_MINUTES=2
MIKROTIK_ISOLATION_FAILURE_THRESHOLD=3
MIKROTIK_ISOLATION_PROCESSING_TIMEOUT_MINUTES=10
MIKROTIK_RESTORE_BATCH_SIZE=25
MIKROTIK_RESTORE_MAX_ATTEMPTS=10
MIKROTIK_RESTORE_RETRY_BASE_MINUTES=2
MIKROTIK_WEBHOOK_TOKEN=
MIKROTIK_WEBHOOK_ALLOWED_IPS=192.168.27.1
